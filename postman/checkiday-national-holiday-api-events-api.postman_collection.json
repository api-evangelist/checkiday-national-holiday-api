              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events?date=<string>&adult=false&timezone=America/Chicago",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "description": "Date to get the events for. Defaults to today. Accepts dates such as `5/5/2025` or ISO `YYYY-MM-DD`.",
                  "key": "date",
                  "value": "<string>"
                },
                {
                  "description": "Include events that may be unsafe for viewing at work or by children. Defaults to false.",
                  "key": "adult",
                  "value": "false"
                },
                {
                  "description": "IANA Time Zone for calculating dates and times. Defaults to `America/Chicago`.",
                  "key": "timezone",
                  "value": "America/Chicago"
                }
              ]
            },
            "description": "Get all events for a specified date. Returns the date's events, any\nmulti-day events that start on that date, and any multi-day events\nthat are continuing their observance on that date.\n"
